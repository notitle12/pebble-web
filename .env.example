# 공개 API 주소만 둔다. 비밀 키나 토큰을 NEXT_PUBLIC 변수에 넣지 않는다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# 네이버 클라우드 Maps의 공개 Client ID. Client Secret은 사용하지 않는다.
NAVER_MAP_CLIENT_ID=

# 약관 정식 공개는 운영 정보와 실제 처리 내역을 확인한 후 활성화한다.
# API의 PEBBLE_LEGAL_PUBLISHED도 동일하게 설정한다. 미설정 시 신규 동의를 받지 않는다.
PEBBLE_LEGAL_PUBLISHED=false
PEBBLE_LEGAL_OPERATOR=Pebble 운영팀 (개인 운영)
# 별도 담당 명칭이 없으면 운영 주체와 같은 문의 담당을 표시한다. 실명 입력 항목이 아니다.
PEBBLE_LEGAL_PRIVACY_OFFICER=
PEBBLE_LEGAL_CONTACT_EMAIL=contact@pebble-log.com
# 실제 업체·업무·국가·항목·목적·이전 시기/방법·보유기간·법적 근거·거부 방법
PEBBLE_LEGAL_PROCESSING_DETAILS=
# 실제 접속/보안 로그 및 백업 보관기간과 파기 절차
PEBBLE_LEGAL_RETENTION_DETAILS=
