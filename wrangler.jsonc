{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pebble-web",
  "account_id": "ae87d49be319ec8a092f90acc9554383",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "pebble-web"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_API_BASE_URL": "https://api.pebble-log.com/api/v1"
  },
  "routes": [
    {
      "pattern": "www.pebble-log.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": false
  }
}
