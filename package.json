{
  "name": "pebble-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname localhost --port 3000",
    "build": "next build",
    "start": "next start --hostname localhost --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "dev:mock": "node scripts/dev-mock.mjs",
    "build:worker": "node scripts/workers.mjs build",
    "preview:worker": "node scripts/workers.mjs preview",
    "deploy:worker": "node scripts/workers.mjs deploy"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "7.0.2",
    "wrangler": "4.147.0"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  }
}
